# --- Correo (IMAP). Gmail: activar 2FA y crear una "contraseña de aplicación" ---
IMAP_HOST=imap.gmail.com
IMAP_USER=tu_correo@gmail.com
IMAP_PASSWORD=app_password_de_16_letras
ALLOWED_SENDER=reportes@empresa.com

# --- IA (opcional: sin clave se usa un resumen determinista) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Supabase Database ---
SUPABASE_URL=https://your-project.supabase.co
# service_role key: solo para pipeline de ingesta (escritura y bypass RLS)
SUPABASE_SERVICE_KEY=your_service_role_key_here
# anon key: para el dashboard (solo lectura protegida por RLS)
SUPABASE_ANON_KEY=your_anon_key_here
